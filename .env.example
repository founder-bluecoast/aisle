# Optional. Unset = embedded PGLite (works offline, good for a shop box / Cursor).
# Set to a Postgres URL for a shared shop database.
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/aisle

# Optional. Mixes into bay/office PIN hashes. If the DB is copied off the box,
# hashes are useless without this value. Changing it invalidates every PIN.
# Leave unset for a local demo. Set it on a real shop box and keep it off git.
# AISLE_PIN_PEPPER=
